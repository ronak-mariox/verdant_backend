# A real MongoDB connection string (local `mongod`, or a MongoDB Atlas URI).
# For zero-setup local dev/CI you can instead set this to the literal string
# "memory" — the server will download and run a real local mongod in a temp
# directory automatically (see src/lib/db.ts). Data is NOT persisted in that mode.
MONGODB_URI="mongodb://127.0.0.1:27017/verdant"
PORT=4000
NODE_ENV=development

# Generate real random secrets for production, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

OTP_LENGTH=6
OTP_TTL_MINUTES=5
# Always-valid OTP for dev/testing since no real SMS provider is wired up yet.
# Automatically disabled when NODE_ENV=production.
DEV_MASTER_OTP="123456"

DEFAULT_ADMIN_NAME="Admin User"
DEFAULT_ADMIN_EMAIL="admin@verdant.app"
DEFAULT_ADMIN_PASSWORD="change-me"

# Comma-separated list of allowed browser origins (mobile apps aren't CORS-restricted)
CORS_ORIGIN="http://localhost:5183"
